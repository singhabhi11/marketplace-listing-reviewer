# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/marketplace_quality_reviewer

# Authentication & JWT
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key
JWT_EXPIRES_IN=7d

# LLM Provider Configuration ('gemini' | 'openai' | 'mock')
# In development or when credentials are absent, the application automatically uses the
# deterministic rule-based heuristic fallback engine without failing or fabricating citations.
LLM_PROVIDER=gemini

# Google Gemini API Credentials (Backend Only - Never exposed to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Credentials (Optional Alternative Backend Provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Batch Processing Limits
MAX_BATCH_SIZE=50
RATE_LIMIT_MAX=300
